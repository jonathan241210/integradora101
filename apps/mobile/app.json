{
  "expo": {
    "name": "ARCA-NB",
    "slug": "mobile",
    "scheme": "arcanb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon/iconZoo.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.tulancingo.arcanb",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon/iconZoo.png",
        "backgroundColor": "#5D031B"
      },
      "usesCleartextTraffic": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "El mapa del zoológico necesita tu ubicación para mostrarte dónde estás dentro del parque."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La app necesita la cámara para leer los códigos QR de los recintos del zoológico."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceder a tus fotos para que elijas la imagen de tu momento.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icon/notification.png",
          "color": "#5D031B",
          "defaultChannel": "news-and-events"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "712699fa-120d-4ae2-b1f0-ae6304c2fec2"
      }
    },
    "owner": "arca-nb"
  }
}
