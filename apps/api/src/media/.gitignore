# api-013: shared test media. Not a privacy filter (ADR 0026).
# Root: ignore everything except this file and the managed folders.
/*
!/.gitignore
!/news/
!/events/
!/memories/
!/species/
!/species-requests/
!/models/

# Inside each folder: only .gitkeep, lowercase images, and approved .glb models.
/news/*
/events/*
/memories/*
/species/*
/species-requests/*
/models/*
!/*/.gitkeep
!/*/*.jpg
!/*/*.jpeg
!/*/*.png
!/*/*.webp
!/*/*.glb
