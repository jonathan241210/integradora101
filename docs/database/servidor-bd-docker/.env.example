# Copia este archivo como .env en esta misma carpeta y ajusta los valores.
# NO commitees el archivo .env.

# Contraseña del usuario root de MySQL (se crea al iniciar el contenedor por primera vez).
# Genera una contraseña fuerte: https://www.lastpass.com/es/features/password-generator
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena

# Base de datos inicial.
MYSQL_DATABASE=arca_pruebas

# Puerto expuesto en la computadora servidor.
MYSQL_PORT=3306
